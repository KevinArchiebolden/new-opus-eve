{
  "name": "opus-eve-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-location.mjs",
    "predev": "node scripts/check-location.mjs",
    "prebuild": "node scripts/check-location.mjs",
    "prepreview": "node scripts/check-location.mjs",
    "images": "node scripts/image-manifest.mjs",
